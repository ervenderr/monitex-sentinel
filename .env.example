# ---- LLM triage ----
# Leave SENTINEL_LLM_PROVIDER=stub to run with no API key at all: the pipeline
# works end to end and the dashboard marks verdicts as rule-derived.
SENTINEL_LLM_PROVIDER=stub          # stub | openai
OPENAI_API_KEY=                     # required when provider=openai
SENTINEL_LLM_MODEL=gpt-4o-mini
SENTINEL_LLM_BASE_URL=https://api.openai.com/v1
SENTINEL_LLM_TIMEOUT_S=6.0
SENTINEL_LLM_MAX_RETRIES=2          # retries on 429/5xx/timeout only
SENTINEL_LLM_CIRCUIT_THRESHOLD=5    # consecutive failures before failing fast
SENTINEL_LLM_CIRCUIT_COOLDOWN_S=30

# Emulated provider think-time for the stub, in ms. Use it to load-test the
# queue against realistic LLM latency without spending anything.
SENTINEL_STUB_LATENCY_MS=0

# ---- Pipeline ----
SENTINEL_EVENT_STREAM_URL=ws://localhost:8765
SENTINEL_QUEUE_MAXSIZE=512          # bounded: backpressure before shedding
SENTINEL_QUEUE_BACKPRESSURE_TIMEOUT_S=2.0
SENTINEL_TRIAGE_WORKERS=4           # concurrent triage workers
SENTINEL_STORE_CAPACITY=1000        # ring buffer of retained alarms

# ---- API ----
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_METRICS_INTERVAL_S=1.0
