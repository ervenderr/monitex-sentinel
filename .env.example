# ---- LLM triage ----
# stub = no API key needed; the pipeline runs end to end on rule verdicts.
SENTINEL_LLM_PROVIDER=deepseek       # stub | deepseek | openai

# Supply the key for whichever provider you selected. The generic
# SENTINEL_LLM_API_KEY works for any provider and takes precedence.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
SENTINEL_LLM_API_KEY=

# Blank = use the provider preset's default (see backend/triage/presets.py).
#   deepseek -> deepseek-flash @ https://api.deepseek.com/v1
#   openai   -> gpt-4o-mini    @ https://api.openai.com/v1
SENTINEL_LLM_MODEL=
SENTINEL_LLM_BASE_URL=

SENTINEL_LLM_TIMEOUT_S=15.0          # deepseek-flash p95 is ~1.2s
SENTINEL_LLM_MAX_RETRIES=2           # retries on 429/5xx/timeout only
SENTINEL_LLM_MAX_OUTPUT_TOKENS=700   # reasoning models need headroom
SENTINEL_LLM_CIRCUIT_THRESHOLD=5     # consecutive failures before failing fast
SENTINEL_LLM_CIRCUIT_COOLDOWN_S=30

# Override per-1M-token rates if the built-in table is stale. Leave unset to
# use the table, which reports no cost for unknown models rather than guessing.
SENTINEL_LLM_PRICE_IN_PER_M=
SENTINEL_LLM_PRICE_OUT_PER_M=

# Emulated provider think-time for the stub, in ms. Use it to load-test the
# queue against realistic LLM latency without spending anything.
SENTINEL_STUB_LATENCY_MS=0

# ---- Pipeline ----
SENTINEL_EVENT_STREAM_URL=ws://localhost:8765
SENTINEL_QUEUE_MAXSIZE=512           # bounded: backpressure before shedding
SENTINEL_QUEUE_BACKPRESSURE_TIMEOUT_S=2.0
SENTINEL_TRIAGE_WORKERS=4            # concurrent triage workers
SENTINEL_STORE_CAPACITY=1000         # ring buffer of retained alarms

# ---- API ----
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_METRICS_INTERVAL_S=1.0

# ---- Camera worker ----
SENTINEL_VIDEO_ENABLED=true
SENTINEL_VIDEO_SOURCE=assets/demo_camera.mp4   # path, or an int index for a webcam
SENTINEL_VIDEO_SITE_ID=site-100
SENTINEL_VIDEO_ZONE=loading-dock
SENTINEL_VIDEO_SAMPLE_FPS=4.0
SENTINEL_VIDEO_COOLDOWN_S=4.0
SENTINEL_VIDEO_PIXEL_THRESHOLD=18
SENTINEL_VIDEO_AREA_THRESHOLD=0.006
